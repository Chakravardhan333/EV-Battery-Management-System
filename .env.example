# Bind to loopback only. Do not expose this prototype on a public interface.
HOST=127.0.0.1
PORT=3000

# simulation | hardware
BMS_MODE=simulation

# Optional. If set, REST and Socket.IO require header/query token.
# BMS_API_TOKEN=

# Hardware serial (Windows example: COM3). Ignored in simulation mode.
SERIAL_PORT=COM3
SERIAL_BAUD=115200
SERIAL_RECONNECT_MS=3000

# Optional MongoDB for historical telemetry. Leave empty to use in-memory history.
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_DB=voltscope
